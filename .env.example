# The shape of the environment. For local work, copy to `apps/web/.env.local` (gitignored): Vite reads
# env files from the host's folder, and `tools/serve/vercel-local.ts` loads the same file for the API.
# Production values live in Vercel, scoped per environment (docs/SECURITY.md §8). Only VITE_* variables
# reach the browser, and the hosts' build defines the two it uses (packages/config/vite's host table).

# --- M0 / M1: prices through the server-side cache (ADR-0006, ADR-0036) -------------------------
# CoinGecko Demo key, server-side only (read by apps/web/server/api.ts behind server-only).
COINGECKO_API_KEY=

# Optional "last good" price store shared by every function instance (Upstash Redis, eu-central-1).
# Without it the function keeps the last good snapshot in memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- M3: accounts, sync, reminders (not read before M3) ---------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# CRON_SECRET=
# MAIL_API_KEY=
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
