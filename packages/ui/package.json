{
  "name": "@proofofcalm/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens, the Tailwind theme, restyled shadcn components on Base UI, chart primitives and Storybook (docs/DESIGN.md).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./styles/*": "./src/styles/*",
    "./fonts/*": "./src/fonts/*",
    "./components/*": "./src/components/*.tsx",
    "./charts/*": "./src/charts/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./storybook": "./.storybook/shared.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint .",
    "test": "vitest run --project unit",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --quiet",
    "storybook:test": "vitest run --project=storybook:*",
    "shadcn": "shadcn"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@proofofcalm/core": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@proofofcalm/config": "workspace:*",
    "@rolldown/plugin-babel": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "storybook": "catalog:",
    "tailwind-merge": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
