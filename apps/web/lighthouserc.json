{
  "ci": {
    "collect": {
      "startServerCommand": "node ../../tools/serve/vercel-local.ts --port 3000 --tls --api node_modules/.cache/lighthouse/api.mjs",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 60000,
      "url": [
        "https://localhost:3000/today",
        "https://localhost:3000/portfolio",
        "https://localhost:3000/log",
        "https://localhost:3000/plan",
        "https://localhost:3000/",
        "https://localhost:3000/en/learn/risk-honestly",
        "https://localhost:3000/en/countries/pt",
        "https://localhost:3000/en/holding-date"
      ],
      "numberOfRuns": 5,
      "puppeteerScript": "node_modules/.cache/lighthouse/seed.cjs",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox", "--allow-insecure-localhost"]
      },
      "settings": {
        "clearStorageTypes": ["file_systems", "shader_cache", "service_workers", "cache_storage"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/today$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 163840 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "errors-in-console": ["error", { "maxLength": 0 }]
          }
        },
        {
          "matchingUrlPattern": "/portfolio$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "errors-in-console": ["error", { "maxLength": 0 }]
          }
        },
        {
          "matchingUrlPattern": "/log$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "errors-in-console": ["error", { "maxLength": 0 }]
          }
        },
        {
          "matchingUrlPattern": "/plan$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "errors-in-console": ["error", { "maxLength": 0 }]
          }
        },
        {
          "matchingUrlPattern": "://[^/]+/$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "errors-in-console": ["error", { "maxLength": 0 }]
          }
        },
        {
          "matchingUrlPattern": "/en/learn/risk-honestly$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "errors-in-console": ["error", { "maxLength": 0 }]
          }
        },
        {
          "matchingUrlPattern": "/en/countries/pt$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "errors-in-console": ["error", { "maxLength": 0 }]
          }
        },
        {
          "matchingUrlPattern": "/en/holding-date$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "errors-in-console": ["error", { "maxLength": 0 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 12288 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
