      "**/apps/web/messages/**",
      "**/packages/content/**",
      "**/apps/web/src/site/**",
      "**/packages/core/src/export/**",
      "**/packages/app/src/features/settings/tax-year*",
      "**/packages/app/src/features/settings/components/tax-year-export*",
      "**/packages/app/src/features/settings/fixtures/tax-year-*",
      "**/packages/core/test/tax-year/**",
      "docs/LEGAL.md",
      "docs/CONTENT-STYLE.md",
      "docs/JURISDICTIONS.md",
      "docs/EDUCATION.md",
      "docs/BENCHMARK.md"
    ]
  },
  "previewHint": "Vercel preview behind deployment protection; sign in to Vercel once"
}
