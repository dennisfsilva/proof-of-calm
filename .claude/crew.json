{
  "check": "pnpm check",
  "gate": "pnpm gate",
  "test": "pnpm test",
  "testCount": "pnpm testCount",
  "e2e": "pnpm test:e2e",
  "deadCode": "pnpm lint:dead",
  "docsLint": "pnpm lint:docs",
  "defaultBranch": "main",
  "subjectMax": 100,
  "branchMax": 34,
  "prLines": 300,
  "evaluator": { "projects": ["android-small", "zoom-125"] },
